{
  "name": "opentofu-generator",
  "version": "0.1.0",
  "private": true,
  "description": "Turns a JSON description of cloud resources into an OpenTofu main.tf for AWS",
  "type": "module",
  "bin": {
    "tofugen": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "tsx src/index.ts examples/input.json infra/main.tf",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
